// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = InteractionFingerprint
PRODUCT_DISPLAY_NAME = Interaction Fingerprint
PRODUCT_BUNDLE_IDENTIFIER = com.biswarupmondal.InteractionFingerprint
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 18.0

// iPhone only (1 == iPhone, 2 == iPad). The study runs on a Face ID iPhone held at a
// marked distance; iPad support would add layouts that areas of interest cannot reuse,
// and iPad multitasking would forbid the portrait lock below.
TARGETED_DEVICE_FAMILY = 1

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
// Portrait only. Gaze is projected with a fixed orientation and areas of interest
// are matched against a fixed layout; rotation mid-session would invalidate both.
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait
// Camera access is required for ARKit TrueDepth face/eye tracking.
// The researcher pulls session exports off the device with Finder or the Files app, so
// the Documents directory has to be visible. Nothing is uploaded anywhere.
INFOPLIST_KEY_UIFileSharingEnabled = YES
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace = YES

INFOPLIST_KEY_NSCameraUsageDescription = This camera access is used to study gaze and facial interaction signals for the Interaction Fingerprint research prototype.


// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/InteractionFingerprint.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/InteractionFingerprint.entitlements

// ==========================================
// Local overrides (signing team, bundle ID)
// ==========================================
// Optional include: present only on a developer's machine, git-ignored.
// See Config/Local.xcconfig.example.
#include? "Local.xcconfig"
